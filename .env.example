# ========================================================
# Our Free Model Docker - Environment Configuration
# ========================================================

# Upstream Git Configuration
# Use 'main' for latest updates or pin to a specific commit SHA (e.g., ddb451c...)
UPSTREAM_REPO=https://github.com/Ebony-Vinyl/dsh-our-free-model.git
UPSTREAM_REF=main

# Cache busting token for Docker rebuilds (change to force fresh git clone)
CACHEBUST=1

# External listening port on host / Coolify
PORT=18900

# Standalone settings
OFM_PROBE=false
OFM_NO_REFRESH=false

# ========================================================
# Egress Proxy Configuration
# ========================================================
# Set to 'http://proxy:8899' to route Our Free Model requests through the proxy sidecar
# Leave empty for direct outbound internet connections
EGRESS_PROXY_URL=

# Proxy Sidecar Mode: disabled | single | pool
# - disabled: Direct connection forwarder (no proxying, neutral pass-through)
# - single:   Route all traffic through PROXY_SINGLE_URL
# - pool:     Rotate and health-check multiple proxies from PROXY_POOL_URLS
PROXY_MODE=disabled

# Single proxy URL (used when PROXY_MODE=single)
# Example: http://user:pass@192.168.1.50:8080 or socks5://127.0.0.1:1080
PROXY_SINGLE_URL=

# Proxy pool list (comma or space separated, used when PROXY_MODE=pool)
# Example: http://p1.local:8080,http://p2.local:8080,socks5://p3.local:1080
PROXY_POOL_URLS=

# Healthcheck and failover parameters
PROXY_CHECK_INTERVAL=300
PROXY_CHECK_TIMEOUT=8
PROXY_COOLDOWN_SECONDS=300
PROXY_ALLOW_DIRECT_FALLBACK=true
PROXY_HEALTH_TARGET=http://www.gstatic.com/generate_204
PROXY_EXPOSE_PORT=8899
